{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devino",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Self-reference service binding, required by OpenNext for Cloudflare's
  // request-context handling. Must match "name" above.
  // See https://opennext.js.org/cloudflare/caching
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "devino",
    },
  ],
  // Non-secret runtime config (brief 02). SITE_URL moves to the real domain
  // once it's connected; ALLOW_INDEXING stays "false" until then so the
  // workers.dev preview is never indexed. TELEGRAM_BOT_TOKEN is a secret:
  // `wrangler secret put TELEGRAM_BOT_TOKEN`.
  "vars": {
    "SITE_URL": "https://devino.amirbagmaz2003.workers.dev",
    "ALLOW_INDEXING": "false",
    // Cloudflare Web Analytics site token (public by design — it ships in
    // the page). Empty = no beacon.
    "CF_WEB_ANALYTICS_TOKEN": "7dba1a33ba54456a891a2fb0becbb661",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devino-db",
      "database_id": "f6fa65e3-6c69-461e-9124-65fbe19dc929",
      "migrations_dir": "migrations",
    },
  ],
  // Media storage: Workers KV, not R2 — R2 needed billing/activation the
  // project owner couldn't do; KV works on the existing free account.
  // Image/video bytes are stored directly under key "media:{id}" (see
  // src/db/admin.ts, src/app/media/[id]/route.ts).
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "6db50f050c9549e5a5786a2f2282de64",
    },
  ],
}
